# Copiar a .env y completar con valores del panel de Railway (nunca commitear .env)

# PostgreSQL — Railway → Connect → DATABASE_URL (usar credencial rotada)
DATABASE_URL=postgresql://postgres:<PASSWORD>@<HOST>:<PORT>/railway

# SSL para Railway (local: DB_SSL=false)
DB_SSL=true

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
